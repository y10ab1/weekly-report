# ===== 必要 =====

# GitHub Personal Access Token (需要 repo 讀取權限)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 你的 GitHub 帳號
GITHUB_USERNAME=your-github-username

# 公司 Email
REPORT_EMAIL=xxx@gamania.com

# 部門名稱 (需與週報系統的下拉選單完全一致)
REPORT_DEPT=你的部門

# 姓名 (需與週報系統的下拉選單完全一致)
REPORT_NAME=你的姓名

# 週報系統網址
REPORT_URL=https://script.google.com/macros/s/xxxxxxxxxx/exec

# 分類設定 (JSON 陣列)
# - name:  分類顯示名稱
# - field: 對應表單的 CSS selector
# - repos: 匹配的 repo 關鍵字，["*"] 代表「其餘全部歸到這類」
CATEGORIES='[{"name":"專案A","field":"#content-1","repos":["repo-keyword-1","repo-keyword-2"]},{"name":"其他事項","field":"#content-2","repos":["*"]}]'

# ===== 可選 =====

# Gemini API Key (用於 AI 自動總結，不設定則使用規則分類)
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 抓取天數 (預設: 7)
# DAYS=7

# 僅預覽不填寫 (預設: false)
# DRY_RUN=true

# 顯示瀏覽器視窗 (預設: true 隱藏)
# HEADLESS=false

# 不使用 AI 總結 (預設: true 使用)
# USE_AI=false
